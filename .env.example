# Copy to .env for local development:  Copy-Item .env.example .env
# Settings module (manage.py defaults to dev, wsgi/asgi default to prod).
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Admin path (SPEC §10: not /admin/). Pick something non-guessable in production.
ADMIN_URL=manage-change-me/

# Database (compose `db` service uses the POSTGRES_* values)
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop

# Redis (huey queue)
REDIS_URL=redis://localhost:6379/0

# Email: Mailpit in dev (inbox UI at http://localhost:8025)
EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL=shop@example.com

# Sentry (empty = disabled)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# S3-compatible media storage (production only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# Production HTTPS tuning (optional)
SECURE_HSTS_SECONDS=3600

# Dev superuser for `manage.py seed_demo` (dev only)
DEV_SUPERUSER_USERNAME=admin
DEV_SUPERUSER_EMAIL=admin@example.com
DEV_SUPERUSER_PASSWORD=
